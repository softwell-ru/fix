<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\AssemblyInfo.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SoftWell.Fix.Initiator.Autofac</AssemblyName>
    <RootNamespace>SoftWell.Fix.Initiator.Autofac</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="('$(TargetFramework)'=='net10.0')">
    <PackageReference Include="Autofac" Version="9.3.4"/>
  </ItemGroup>

  <ItemGroup Condition="('$(TargetFramework)'=='net8.0')">
    <PackageReference Include="Autofac" Version="8.0.0"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Fix.Initiator/Fix.Initiator.csproj" />
  </ItemGroup>

</Project>